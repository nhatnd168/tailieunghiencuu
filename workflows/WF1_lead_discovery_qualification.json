      "id": "a1b2c3d4-0013-0013-0013-000000000013",
      "name": "Airtable - Save Qualified Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [2880, 140]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ '🎯 *Lead mới cần review!*\\n\\n👤 *' + $('Parse AI Score').item.json.name + '*\\n🏢 ' + $('Parse AI Score').item.json.company + '\\n💼 ' + $('Parse AI Score').item.json.title + '\\n🌍 ' + $('Parse AI Score').item.json.country + '\\n🏭 ' + $('Parse AI Score').item.json.industry + '\\n\\n⭐ *Điểm AI: ' + $('Parse AI Score').item.json.ai_score + '/10*\\n📝 ' + $('Parse AI Score').item.json.ai_reasoning + '\\n\\n🔗 ' + ($('Parse AI Score').item.json.linkedin_url || 'Không có LinkedIn') + '\\n\\n✅ Vào Airtable để *Approve* hoặc *Reject*' }}",
        "additionalFields": {
